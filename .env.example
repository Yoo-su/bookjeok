# 로컬 개발용 설정 예시. 실제 비밀 값은 Git에서 제외된 환경 파일에 입력합니다.

NODE_ENV=development
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookjeok
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bookjeok
DATABASE_SSL=false

JWT_SECRET=your_jwt_access_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters

CLIENT_DOMAIN=http://localhost:3000

NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=http://localhost:8000/api/auth/naver/callback

KAKAO_CLIENT_ID=your_kakao_client_id_or_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_CALLBACK_URL=http://localhost:8000/api/auth/kakao/callback

RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=북적 <noreply@yourdomain.com>
FEEDBACK_NOTIFY_EMAIL=

GEMINI_API_KEY=your_google_gemini_api_key_here

# GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# AI_SIMILARITY_THRESHOLD=0.35
# AI_CANDIDATE_POOL_SIZE=30

BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

TOSS_PAYMENTS_SECRET_KEY=test_sk_your_toss_secret_key_here
TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_toss_client_key_here

FEATURE_PAYMENT_ENABLED=false

# DELIVERY_TRACKER_BASE_URL=https://apis.tracker.delivery

REVALIDATE_TOKEN=your_revalidate_secret_token_here

USER_WEB_URL=http://localhost:3000

INDEXNOW_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_toss_client_key_here
NEXT_PUBLIC_FEATURE_PAYMENT_ENABLED=false

NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_javascript_app_key

# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id
# NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
