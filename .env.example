# ==============================================================================
# 로컬 개발 환경용 환경변수 템플릿 (.env.example)
# 이 파일을 복사하여 루트에 .env 파일을 만들고 실제 값을 채워 넣어주세요.
# .env 파일은 Git 형상관리 대상에서 자동으로 제외되므로 보안상 안전합니다.
# ==============================================================================

# Node 환경
NODE_ENV=development
PORT=8000

# 데이터베이스 (PostgreSQL)
# 로컬(호스트)에서 pnpm dev 구동 시: localhost:5432 / Docker 내에서만 구동 시: db:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookjeok
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bookjeok
DATABASE_SSL=false

# JWT 인증 토큰 시크릿 키
# (충분히 길고 안전한 임의의 문자열을 적어주세요.)
JWT_SECRET=your_jwt_access_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters

# 도메인 설정 (소셜 로그인 및 콜백 처리에 필요)
CLIENT_DOMAIN=http://localhost:3000

# 네이버 소셜 로그인 연동 키 (도서 검색에는 쓰지 않습니다)
# (네이버 개발자 센터에서 앱을 만들고 발급받은 실제 값을 기재하세요.)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=http://localhost:8000/api/auth/naver/callback

# 카카오 소셜 로그인 연동 키
# (카카오 디벨로퍼스에서 앱을 만들고 발급받은 REST API 키 / Client Secret을 기재하세요.)
KAKAO_CLIENT_ID=your_kakao_client_id_or_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_CALLBACK_URL=http://localhost:8000/api/auth/kakao/callback

# Resend 이메일 발송 연동 키 (회원가입 인증 링크 & 채팅 알림 발송)
RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=북적 <noreply@yourdomain.com> # 미설정 시 '북적 <onboarding@resend.dev>' 기본 사용
# 사용자 문의·제보를 받을 운영자 메일. 미설정 시 문의는 DB에만 쌓이고 알림 메일은 보내지 않음
FEEDBACK_NOTIFY_EMAIL=

# 알라딘 Open API TTBKey — 2026-10-30 종료 예정
# 서버·웹은 쓰지 않습니다(공급처 체인에서 제거됨). 종료 전까지
# tools/book-ingest의 알라딘 공급처만 이 키를 씁니다(루트 .env에서 읽음).
# 신규 발급이 불가하므로 지우지 마세요.
ALADIN_TTB_KEY=your_aladin_ttb_key_here

# Google Generative AI (Gemini) API 키
# (Google AI Studio에서 발급받은 API 키를 기재하세요.)
GEMINI_API_KEY=your_google_gemini_api_key_here

# AI 도서 추천(search 모듈)의 Gemini 모델명 (선택 — 미설정 시 gemini-3.1-flash-lite)
# AI 도서 요약(llm 모듈)은 이 값을 읽지 않고 llm/constants/llm-model.ts 상수를 씁니다.
# GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# AI 도서 추천 유사도 설정 (선택 — 미설정 시 기본값 사용)
# AI_SIMILARITY_THRESHOLD=0.35    # 최소 코사인 유사도 (0~1, 높을수록 엄격)
# AI_CANDIDATE_POOL_SIZE=30       # pgvector 원시 후보 풀 크기

# Vercel Blob 스토리지 인증 키 (도서 이미지 업로드/삭제 필수)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# 토스페이먼츠 연동 키 (에스크로 결제 연동)
TOSS_PAYMENTS_SECRET_KEY=test_sk_your_toss_secret_key_here
TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_toss_client_key_here

# 결제 기능 활성화 플래그 (PG 승인 전: false / 승인 후: true)
FEATURE_PAYMENT_ENABLED=false

# 택배 배송 추적 API 엔드포인트 (선택 — 미설정 시 https://apis.tracker.delivery 사용)
# DELIVERY_TRACKER_BASE_URL=https://apis.tracker.delivery

# On-Demand ISR 캐시 갱신 시크릿 (web /api/revalidate 검증, 서버 리뷰 IndexNow에서도 사용)
# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 노출된다
# 미설정 시 /api/revalidate는 503으로 실패한다 (폴백 없음)
REVALIDATE_TOKEN=your_revalidate_secret_token_here

# 서버가 캐시 갱신 요청을 보낼 사용자 웹 주소 (운영 IndexNow는 https://bookjeok.com)
USER_WEB_URL=http://localhost:3000

# 서버 전용. 운영에서만 true: 공개 리뷰 변경 후 상세 캐시 갱신 → 네이버 IndexNow 알림
# 먼저 웹의 공개 키 파일을 배포하고 web/server의 REVALIDATE_TOKEN을 동일하게 설정
INDEXNOW_ENABLED=false

# 프론트엔드 빌드 타임 주입 환경변수
# (Next.js 빌드 시 클라이언트 측에서 바라볼 백엔드 주소입니다.)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_toss_client_key_here
NEXT_PUBLIC_FEATURE_PAYMENT_ENABLED=false

# 카카오 맵 JavaScript SDK 키 (중고 거래 지도 렌더링에 필수)
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_javascript_app_key

# 웹 계측/광고 (선택 — 미설정 시 해당 스크립트를 로드하지 않음)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id
# NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX

