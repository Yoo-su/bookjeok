{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookjeok/web", "storybook", "--no-open"],
      "port": 6006
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookjeok/web", "dev"],
      "port": 3000
    },
    {
      "name": "book-ingest",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["ingest", "serve"],
      "port": 4700,
      "url": "http://127.0.0.1:4700"
    }
  ]
}
