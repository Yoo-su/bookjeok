{
  "name": "bookjeok-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@bookjeok/web --filter=@bookjeok/server --filter=@bookjeok/core",
    "dev:server": "turbo dev --filter=@bookjeok/server --filter=@bookjeok/core",
    "dev:all": "turbo dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "build": "turbo build",
    "build:web": "turbo build --filter=@bookjeok/web",
    "clean": "turbo clean",
    "build:clean": "pnpm build",
    "start": "turbo start",
    "start:web": "turbo start --filter=@bookjeok/web --filter=@bookjeok/server",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "test": "turbo test",
    "storybook": "pnpm --filter=@bookjeok/web storybook",
    "ingest": "pnpm --filter=@bookjeok/book-ingest ingest"
  },
  "devDependencies": {
    "turbo": "2.7.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "axios": "^1.11.0",
    "@tanstack/react-query": "^5.84.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
