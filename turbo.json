{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "packages/tsconfig.json",
    "packages/tsup.config.base.ts"
  ],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "API_URL",
    "CLIENT_DOMAIN",
    "DATABASE_URL",
    "DATABASE_USERNAME",
    "DATABASE_PASSWORD",
    "DATABASE_NAME",
    "DATABASE_SSL",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "NAVER_CLIENT_ID",
    "NAVER_CLIENT_SECRET",
    "NAVER_CALLBACK_URL",
    "KAKAO_CLIENT_ID",
    "KAKAO_CLIENT_SECRET",
    "KAKAO_CALLBACK_URL",
    "GEMINI_API_KEY",
    "GEMINI_MODEL_NAME",
    "BLOB_READ_WRITE_TOKEN",
    "AI_SIMILARITY_THRESHOLD",
    "AI_CANDIDATE_POOL_SIZE",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "FEEDBACK_NOTIFY_EMAIL",
    "TOSS_PAYMENTS_SECRET_KEY",
    "TOSS_PAYMENTS_CLIENT_KEY",
    "FEATURE_PAYMENT_ENABLED",
    "DELIVERY_TRACKER_BASE_URL",
    "REVALIDATE_TOKEN",
    "USER_WEB_URL",
    "INDEXNOW_ENABLED",
    "OUTPUT_STANDALONE",
    "DOCKER",
    "ANALYZE",
    "VERCEL_ENV",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_KAKAO_APP_KEY",
    "NEXT_PUBLIC_GOOGLE_ADSENSE_ID",
    "NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY",
    "NEXT_PUBLIC_FEATURE_PAYMENT_ENABLED",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_CLARITY_PROJECT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
