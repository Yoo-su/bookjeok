# book-ingest 전용 환경변수. 이 파일을 .env로 복사해 채우세요(.env는 gitignore 대상).
# 같은 이름이 여기 없으면 저장소 루트 .env에서 읽습니다.
# 서버·웹이 쓰지 않는 값이라 turbo.json globalEnv에는 등록하지 않습니다.

# 카카오 책 검색 — Kakao Developers > 앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=

# 운영 DB(Supabase 풀러). books SELECT·INSERT만 가진 전용 역할을 권장합니다.
# 예: postgresql://book_ingest.<project-ref>:<비밀번호>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
INGEST_DATABASE_URL=

# Cloudflare R2 — 버킷 bookjeok-covers 한정 Object Read & Write 토큰
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bookjeok-covers

# 표지 공개 주소 (기본값을 바꿀 일은 거의 없습니다)
# INGEST_CDN_BASE=https://cdn.bookjeok.com
